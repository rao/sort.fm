# Build from the repository root. Only declared build inputs enter the context.
**
!package.json
!bun.lock
!tsconfig.json
!apps/
!apps/api/
!apps/api/package.json
!apps/api/src/
!apps/api/src/**
!apps/web/
!apps/web/package.json
!packages/
!packages/contracts/
!packages/contracts/package.json
!packages/contracts/src/
!packages/contracts/src/**
!packages/db/
!packages/db/package.json
!packages/db/src/
!packages/db/src/**
!services/
!services/ml/
!services/ml/pyproject.toml
!services/ml/uv.lock
!services/ml/src/
!services/ml/src/**
!services/ml/fixtures/
!services/ml/fixtures/authored_profiles.json
!deploy/
!deploy/**

# Also deny private/local material inside an allowed source directory.
**/.git
**/.git/**
**/.env
**/.env.*
**/node_modules/**
**/.venv/**
**/__pycache__/**
**/artifacts/**
**/backups/**
**/secrets/**
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.bak
**/*.backup
**/*.dump
**/*.log
**/*.pyc
**/*.test.*
**/test-support/**
