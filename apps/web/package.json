{
  "name": "@sortfm/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#ui/components/*": "./src/components/*.tsx",
    "#ui/utils/*": "./src/utils/*.ts"
  },
  "scripts": {
    "dev": "bun --bun vite --host 127.0.0.1",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview --host 127.0.0.1",
    "lint": "bunx @biomejs/biome@2.3.4 lint src",
    "test": "bun test src",
    "build:draft": "bun --bun vite build --config vite.draft.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@remixicon/react": "^4.9.0",
    "@sortfm/contracts": "workspace:*",
    "@tailwindcss/postcss": "^4.3.5",
    "motion": "^14.10.1",
    "react": "^19.2.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "vite": "^7.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
