{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "cd ../.. && bunx bun@1.4.3 install --frozen-lockfile",
  "buildCommand": "cd ../.. && bunx bun@1.4.3 run --filter @sortfm/web build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
