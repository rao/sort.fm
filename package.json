{
  "name": "sort-fm", "private": true, "version": "0.0.0", "type": "module",
  "packageManager": "bun@1.4.3", "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun --env-file=.env --watch apps/api/src/index.ts",
    "dev:web": "bun run --filter @sortfm/web dev",
    "dev:ml": "bun --env-file=.env scripts/dev-ml.ts",
    "typecheck": "tsc --noEmit", "test": "bun test",
    "test:ml": "uv run --directory services/ml pytest",
    "build": "bun run --filter @sortfm/web build && bun build apps/api/src/index.ts --target=bun --outdir apps/api/dist",
    "contracts:export": "bun run scripts/export-contracts.ts",
    "seed:demo": "bun run scripts/seed-demo.ts",
    "smoke": "bun run scripts/smoke-foundation.ts",
    "smoke:ml": "bun run scripts/smoke-ml.ts"
  },
  "devDependencies": { "@types/bun": "^1.3.0", "typescript": "^5.9.3", "zod": "^4.1.12" }
}
