# Server only. Copy to .env at the repository root. Never commit real credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_WEB_ORIGIN=http://127.0.0.1:5173
PUBLIC_API_ORIGIN=http://127.0.0.1:3001
# Production: PUBLIC_WEB_ORIGIN=https://sort.fm, PUBLIC_API_ORIGIN=https://api.sort.fm
DEMO_MODE_ENABLED=true
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3001/api/auth/spotify/callback
SPOTIFY_ALLOWED_USER_IDS=
SOUNDNET_RAPIDAPI_KEY=
DATABASE_URL=
SESSION_SECRET=
TOKEN_ENCRYPTION_KEY=
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_SHARED_SECRET=
# Only public values may ever use VITE_. Vite proxies /api to the API in development.
# Deployment: VITE_API_ORIGIN=https://api.sort.fm
